# TheMQ environment configuration — OPTIONAL.
# Normal Docker deployment needs no `.env` file. Application defaults are
# production-safe; the image defaults REDIS_URL to the Compose Redis service.
# Copy this file only when you want to override defaults. Values are
# validated at startup; the process fails fast on invalid configuration.

# --- Redis ---
# Connection URL for Redis (the only backend TheMQ needs).
# Default outside Docker: redis://127.0.0.1:6379
# Default in the published image: redis://redis:6379 (Compose service name)
REDIS_URL=redis://127.0.0.1:6379
# Key prefix for all broker keys plus the auto-managed API token.
REDIS_KEY_PREFIX=themq
# Self-tune a stock Redis server at startup (append-only log + snapshots +
# memory guard, re-applied every boot). Set false for external/managed Redis
# where CONFIG commands are restricted.
REDIS_TUNING=true
# Redis memory cap in MB (applied when REDIS_TUNING=true). Guide: 128 on a
# 512MB box, 256 on 1GB (default), 512 on 2GB+.
REDIS_MAXMEMORY_MB=256

# --- API ---
API_HOST=0.0.0.0
# Port the HTTP API listens on. Use 0 only for tests (ephemeral port).
API_PORT=3000
# Bearer token for all API routes except /health/*.
# Optional: when unset, TheMQ generates a random token on first start and
# persists it in Redis (stable while Redis data lives). The token is never
# logged — fetch it with: redis-cli GET <REDIS_KEY_PREFIX>:auth:api-token.
# docker-compose.yml pins API_TOKEN by default (overridable via environment);
# set API_TOKEN here only to override the compose value.
API_TOKEN=
# Development-only bypass. NEVER set true in production.
AUTH_DISABLED=false

# --- Consumer defaults ---
# Lease per consumed message (ms): unacked past this, it is redelivered.
# Overridable per consume call via visibilityTimeoutMs.
DEFAULT_VISIBILITY_TIMEOUT_MS=30000
# Max messages leased to one consumer at once (overridable per consume call).
DEFAULT_PREFETCH=100
# Max messages returned by a single consume call.
MAX_CONSUME_COUNT=100

# --- Sweeper ---
# Interval (ms) for the background sweep that promotes TTL-expired messages
# and reclaims expired unacked leases when no consumer is pulling.
SWEEPER_INTERVAL_MS=1000

# --- Limits ---
# Maximum message payload size in bytes (JSON-encoded data).
MAX_MESSAGE_BYTES=1048576

# --- Logging ---
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs (development). Production default is JSON.
LOG_PRETTY=false
