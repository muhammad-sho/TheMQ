{
  "name": "themq",
  "version": "3.2.0",
  "description": "TheMQ — a lightweight, Redis-backed queue/consumer message broker with message delete and TTL reset.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests eslint.config.js vitest.config.ts prettier.config.js",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/api",
    "test:integration": "vitest run tests/integration"
  },
  "keywords": ["message-queue", "redis", "broker", "n8n"],
  "author": "TheMQ contributors",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/muhammad-sho/TheMQ.git"
  },
  "homepage": "https://github.com/muhammad-sho/TheMQ",
  "bugs": {
    "url": "https://github.com/muhammad-sho/TheMQ/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.1",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "ws": "^8.21.3"
  }
}
